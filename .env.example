# Copy to .env - docker compose reads it automatically. All optional.

# Claude API key. Without it, LLM steps and AI features run in local mock mode.
ANTHROPIC_API_KEY=
# auto | live | mock
LLM_MODE=auto
CLAUDE_MODEL=claude-opus-5-5

# Shared secret for the API and dashboard (set it in the dashboard's operator settings).
API_TOKEN=

# Host ports for the compose datastores (5432/6379 are often taken by local installs).
PG_HOST_PORT=55432
REDIS_HOST_PORT=56379
